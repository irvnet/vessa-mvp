# Vessa backend — required environment variables. Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Comma-separated list of allowed frontend origins for CORS (see app/main.py).
# Defaults to local dev; add the deployed Vercel URL once the frontend is live.
ALLOWED_ORIGINS=http://localhost:3000

# Minutes between proactive check-ins (see app/scheduler.py). Default 2 keeps them
# visible during a demo; raise it for a long rehearsal.
CHECKIN_INTERVAL_MINUTES=2
# How long an unanswered check-in holds off the next one. Lower it before a demo so a
# nudge left pending from rehearsal can't keep the scheduler quiet on stage.
CHECKIN_FOLLOWUP_MINUTES=10

# --- Voice (optional; see app/voice.py). STT always uses OPENAI_API_KEY above. ---
# TTS provider: openai (default, works on the OpenAI key) or elevenlabs (premium
# warm voice — needs an ElevenLabs *paid* plan; free-tier keys 402 on library voices).
TTS_PROVIDER=openai
# ELEVENLABS_API_KEY=sk_...           # only needed if TTS_PROVIDER=elevenlabs
# VESSA_VOICE_ID=21m00Tcm4TlvDq8ikWAM # override the default ElevenLabs voice
